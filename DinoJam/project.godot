; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dino Jam"
run/main_scene="res://Scenes/test_scene.tscn"
config/features=PackedStringArray("4.2", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://Scripts/Managers/EventBus.cs"
EdibleManager="*res://Scenes/edible_manager.tscn"

[display]

window/size/viewport_width=768
window/size/viewport_height=432
window/stretch/mode="viewport"
window/stretch/scale=2.0
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Dino Jam"

[input]


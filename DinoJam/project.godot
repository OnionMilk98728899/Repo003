[layer_names]

2d_physics/layer_1="Floor"
2d_physics/layer_2="Ladders"
2d_physics/layer_3="LadderTops"
2d_physics/layer_4="Player"
2d_physics/layer_5="Enemies"
2d_physics/layer_6="Collectibles"
2d_physics/layer_7="Hazards"

[rendering]

